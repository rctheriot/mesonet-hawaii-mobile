# Copy this file to .env.local and fill in your values
VITE_MESONET_API_KEY=your_api_key_here
VITE_CARTO_API_KEY=your_carto_key_here

# Which region this build targets. Optional locally — defaults to 'hawaii'.
# Known values are the keys of REGIONS in src/config/regions.data.ts:
#   hawaii | american_samoa
# In Cloudflare Pages this is set per project, not here.
VITE_APP_DATA=hawaii
